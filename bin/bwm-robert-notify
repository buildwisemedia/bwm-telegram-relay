#!/usr/bin/env bash
# bwm-robert-notify — send Robert a typed One Wire message (Attention-Routing v2.0.0).
#
# Usage:
#   bwm-robert-notify --type fire|call|signoff|fyi --punchline "one line" \
#     [--stakes "what it means in $"] [--rec "my recommendation"] [--ask "the ask"] \
#     [--option "label"] [--option "label"] [--link URL] [--key suppress-key] \
#     [--expires YYYY-MM-DD] [--origin name] [--judgment '{...}'] \
#     [--json '{...raw body...}'] [--dry-run]
#
# --judgment (call/signoff only) opts the decision into PROJ-UPLIFT-001
# judgment capture — set it ONLY for genuine business forks with a checkable
# future outcome (never plumbing/go-live/test calls). JSON object:
#   {"domain":"pricing|offer|client_select|copy|hiring|strategy|ops|other",
#    "outcome_knowable_by":"plain words (required)",
#    "outcome_knowable_at":"YYYY-MM-DD (optional)",
#    "claude_prediction":"defaults to --rec", "claude_confidence":0.7,
#    "loop":"both", "resolution":{...contract §9 spec...}}
# The wire send never fails on a bad judgment object — the relay drops it and
# reports `judgment: "dropped: <reason>"` in the response. Check for it.
#
# Types:
#   fyi     — NEVER pings; queues into the Day Done digest.
#   call    — a decision only Robert can make; include --rec + --option(s).
#   signoff — client-facing HITL approval; include --link to the review page.
#   fire    — client/business breakage; repeats with the same --key EDIT the
#             original message instead of re-pinging.
#
# --dry-run resolves the key and builds the body, then prints the body and
# where the key came from (never the key) without sending anything.
#
# Auth: $BWM_INTERNAL_KEY, else the vault file $BWM_INTERNAL_KEY_FILE
# (default ~/.bwm_secrets/ea-substrate.env, the internal-key rotation tool's
# canonical holder), else the legacy ~/.claude/settings.json env block. The
# vault file must be a regular file owned by you with no group/other access.
# The key is sent on curl's stdin, never on a command line.
# Exit: 0 sent/queued · 64 bad args · 78 no key · 1 relay error.
set -euo pipefail

RELAY_URL="${BWM_TELEGRAM_RELAY_URL:-https://bwm-telegram-relay.robert-ba0.workers.dev}"

TYPE="" PUNCHLINE="" STAKES="" REC="" ASK="" LINK="" KEY="" EXPIRES="" ORIGIN="" JUDGMENT="" RAW_JSON=""
DRY_RUN=0
OPTIONS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --type)      TYPE="$2"; shift 2;;
    --punchline) PUNCHLINE="$2"; shift 2;;
    --stakes)    STAKES="$2"; shift 2;;
    --rec)       REC="$2"; shift 2;;
    --ask)       ASK="$2"; shift 2;;
    --option)    OPTIONS+=("$2"); shift 2;;
    --link)      LINK="$2"; shift 2;;
    --key)       KEY="$2"; shift 2;;
    --expires)   EXPIRES="$2"; shift 2;;
    --origin)    ORIGIN="$2"; shift 2;;
    --judgment)  JUDGMENT="$2"; shift 2;;
    --json)      RAW_JSON="$2"; shift 2;;
    --dry-run)   DRY_RUN=1; shift;;
    -h|--help)   sed -n '2,37p' "$0" | sed 's/^# \{0,1\}//'; exit 0;;
    *) echo "bwm-robert-notify: unknown arg: $1" >&2; exit 64;;
  esac
done

KEY_SOURCE="env"
if [ -z "${BWM_INTERNAL_KEY:-}" ]; then
  # Two lines on stdout: where the key came from, then the key. A pipe, not
  # argv or the environment, carries it back to this shell.
  # The helper is a top-level here-document: bash 3.2 (macOS /bin/bash) can't
  # parse one inside a process substitution.
  read -r -d '' RESOLVE_KEY_PY <<'PY' || true
import json, os, stat, sys

def parse_env(text):
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        name, value = line.split("=", 1)
        name = name.strip()
        if name.startswith("export "):
            name = name[len("export "):].strip()
        if name != "BWM_INTERNAL_KEY":
            continue
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "'\"":
            value = value[1:-1]
        return value
    return ""

def read_vault(path):
    # Same checks as log-event's secure reader: no symlink, regular file,
    # owned by this user, no group or other permission bits. The descriptor
    # is checked before it is wrapped, and O_NONBLOCK keeps a FIFO from
    # hanging the open, so a bad vault path falls through to the legacy
    # fallback instead of stopping the resolver.
    flags = (os.O_RDONLY | os.O_NONBLOCK | getattr(os, "O_CLOEXEC", 0)
             | getattr(os, "O_NOFOLLOW", 0))
    try:
        fd = os.open(path, flags)
    except FileNotFoundError:
        return ""
    except OSError as exc:
        print(f"bwm-robert-notify: ignoring {path}: {exc.strerror}", file=sys.stderr)
        return ""
    meta = os.fstat(fd)
    problem = ""
    if not stat.S_ISREG(meta.st_mode):
        problem = "not a regular file"
    elif meta.st_uid != os.geteuid():
        problem = "not owned by this user"
    elif meta.st_mode & 0o077:
        problem = "permissions too open (want 600)"
    if problem:
        os.close(fd)
        print(f"bwm-robert-notify: ignoring {path}: {problem}", file=sys.stderr)
        return ""
    try:
        with os.fdopen(fd, "r", encoding="utf-8") as handle:
            return parse_env(handle.read())
    except (OSError, UnicodeDecodeError) as exc:
        # Name the error class only: a decode error's text quotes file bytes.
        print(f"bwm-robert-notify: ignoring {path}: unreadable ({type(exc).__name__})", file=sys.stderr)
        return ""

vault = os.environ.get("BWM_INTERNAL_KEY_FILE") or os.path.expanduser("~/.bwm_secrets/ea-substrate.env")
value = read_vault(vault)
source = "vault"
if not value:
    source = "settings"
    try:
        with open(os.path.expanduser("~/.claude/settings.json"), encoding="utf-8") as handle:
            value = str(json.load(handle).get("env", {}).get("BWM_INTERNAL_KEY", "") or "")
    except Exception:
        value = ""
if "\n" in value or "\r" in value:
    value = ""
print(source if value else "none")
print(value)
PY
  KEY_SOURCE="" BWM_INTERNAL_KEY=""
  { IFS= read -r KEY_SOURCE || true; IFS= read -r BWM_INTERNAL_KEY || true; } < <(python3 -c "$RESOLVE_KEY_PY")
fi
if [ -z "$BWM_INTERNAL_KEY" ]; then
  echo "bwm-robert-notify: BWM_INTERNAL_KEY not found (export, vault file or settings.json env)" >&2
  exit 78
fi

if [ -n "$RAW_JSON" ]; then
  BODY="$RAW_JSON"
else
  if [ -z "$TYPE" ] || [ -z "$PUNCHLINE" ]; then
    echo "bwm-robert-notify: --type and --punchline are required (or --json)" >&2
    exit 64
  fi
  BODY=$(
    TYPE="$TYPE" PUNCHLINE="$PUNCHLINE" STAKES="$STAKES" REC="$REC" ASK="$ASK" \
    LINK="$LINK" KEY="$KEY" EXPIRES="$EXPIRES" ORIGIN="${ORIGIN:-cli:$(whoami)}" \
    JUDGMENT="$JUDGMENT" \
    python3 -c '
import json, os, sys
body = {"type": os.environ["TYPE"], "punchline": os.environ["PUNCHLINE"]}
for arg, field in (("STAKES","stakes"),("REC","rec"),("ASK","ask"),("LINK","link"),
                   ("KEY","key"),("EXPIRES","expires_at"),("ORIGIN","origin")):
    v = os.environ.get(arg, "")
    if v: body[field] = v
j = os.environ.get("JUDGMENT", "")
if j:
    try:
        parsed = json.loads(j)
        # allow_nan=False round-trip: NaN/Infinity parse fine but serialize
        # as invalid JSON that Workers rejects WHOLE-REQUEST — losing the
        # CALL itself (codex r5).
        json.dumps(parsed, allow_nan=False)
        body["judgment"] = parsed
    except ValueError:
        # NEVER block the wire on a capture problem (contract: fails safe) —
        # a hard exit here would silently lose the CALL itself for an
        # unattended sender (codex r2). Send without the opt-in and warn.
        print("bwm-robert-notify: --judgment is not valid JSON — "
              "sending WITHOUT the judgment-capture opt-in", file=sys.stderr)
opts = [o for o in sys.argv[1:] if o.strip()]
if opts: body["options"] = opts
print(json.dumps(body))
' ${OPTIONS[@]+"${OPTIONS[@]}"}
  )
fi

if [ "$DRY_RUN" = 1 ]; then
  RELAY_URL="$RELAY_URL" KEY_SOURCE="$KEY_SOURCE" BODY="$BODY" python3 -c '
import json, os
try:
    body = json.loads(os.environ["BODY"])
except ValueError:
    body = os.environ["BODY"]
print(json.dumps({"dry_run": True, "relay": os.environ["RELAY_URL"] + "/notify",
                  "key_source": os.environ["KEY_SOURCE"], "body": body}))
'
  exit 0
fi

# curl, not python-urllib: Cloudflare blocks the python-urllib UA (error 1010).
# The key header goes in on stdin (-H @-) so it never shows in a process list.
RESP=$(curl -sS -w $'\n%{http_code}' -X POST "$RELAY_URL/notify" \
  -H @- \
  -H "Content-Type: application/json" \
  --data "$BODY" <<<"X-BWM-Internal-Key: $BWM_INTERNAL_KEY")
CODE=$(printf '%s' "$RESP" | tail -n1)
PAYLOAD=$(printf '%s' "$RESP" | sed '$d')
printf '%s\n' "$PAYLOAD"
if [ "$CODE" != "200" ]; then
  echo "bwm-robert-notify: relay returned HTTP $CODE" >&2
  exit 1
fi
